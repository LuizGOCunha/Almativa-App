# --- Servidor -------------------------------------------------------
NODE_ENV=development
PORT=3333
API_PREFIX=/api
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
TIMEZONE=America/Sao_Paulo

# --- Postgres (cadastro, financeiro, autenticacao) ------------------
DATABASE_URL=postgresql://almativa:almativa@localhost:5432/almativa?schema=public

# --- MongoDB (eventos: checkin, frequencia, notificacoes, campanhas)-
MONGO_URL=mongodb://localhost:27017/almativa_eventos?replicaSet=rs0&directConnection=true

# --- Autenticacao ---------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-em-producao
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Token do dispositivo de TV (perfil AULA) - vida longa
JWT_DEVICE_TTL=365d

# --- Jobs agendados -------------------------------------------------
JOBS_ENABLED=true
# Todo dia as 08:00
CRON_LEMBRETES_VENCIMENTO=0 8 * * *
# Todo dia as 00:10 - marca mensalidades vencidas
CRON_MARCAR_VENCIDAS=10 0 * * *
# Toda segunda as 03:00 - gera ocorrencias de aula das proximas 4 semanas
CRON_GERAR_AULAS=0 3 * * 1
# Todo dia 1 as 02:00 - gera mensalidades da competencia
CRON_GERAR_MENSALIDADES=0 2 1 * *
DIAS_AVISO_VENCIMENTO=7,3,1

# --- Seed -----------------------------------------------------------
SEED_ADMIN_EMAIL=admin@almativa.com.br
SEED_ADMIN_SENHA=almativa123
